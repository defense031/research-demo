% beamerthemeWestPoint.sty: a small West Point look for Beamer.
% Black, gold, and gray, with the USMA crest on the title page and the
% Math Mule in the footer. Colors approximate USMA's palette.
\mode<presentation>

\definecolor{wpblack}{HTML}{1B1B18}
\definecolor{wpgold}{HTML}{B5985A}
\definecolor{wpgray}{HTML}{8C8C8C}
\definecolor{wplight}{HTML}{F4F1EA}

\usefonttheme{professionalfonts}
\usepackage[T1]{fontenc}
\usepackage{lmodern}
\setbeamertemplate{navigation symbols}{}

\setbeamercolor{normal text}{fg=wpblack,bg=white}
\setbeamercolor{structure}{fg=wpgold}
\setbeamercolor{frametitle}{fg=white,bg=wpblack}
\setbeamercolor{goldrule}{bg=wpgold}
\setbeamercolor{title}{fg=wpblack}
\setbeamercolor{subtitle}{fg=wpgold}
\setbeamercolor{author}{fg=wpblack}
\setbeamercolor{institute}{fg=wpgray}
\setbeamercolor{date}{fg=wpgray}
\setbeamercolor{block title}{fg=white,bg=wpblack}
\setbeamercolor{block body}{fg=wpblack,bg=wplight}
\setbeamercolor{item}{fg=wpgold}
\setbeamerfont{frametitle}{series=\bfseries,size=\Large}
\setbeamerfont{title}{series=\bfseries,size=\LARGE}
\setbeamertemplate{itemize items}[square]
\setbeamertemplate{blocks}[rounded][shadow=false]

% black title bar with a gold rule under it
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.2em,dp=1.0em,leftskip=1em,rightskip=1em]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle
  \end{beamercolorbox}%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,ht=2pt,dp=0pt]{goldrule}\end{beamercolorbox}%
  \vspace{0.4em}}

% footer: mule on the left, short title in the middle, slide number on the right
\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.0em,dp=0.6em,leftskip=0.6em,rightskip=1em]{}%
    \raisebox{-0.35em}{\includegraphics[height=1.4em]{figures/math_mule.png}}%
    \hfill{\color{wpgray}\scriptsize\insertshorttitle}\hfill
    {\color{wpgold}\scriptsize\bfseries\insertframenumber}%
  \end{beamercolorbox}}

% title page: crest on the left, gold rule, text on the right
\setbeamertemplate{title page}{%
  \begin{columns}[c]
    \begin{column}{0.30\textwidth}\centering
      \includegraphics[width=0.95\linewidth]{figures/usma_crest.png}
    \end{column}
    \begin{column}{0.66\textwidth}
      {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
      \vspace{0.3em}
      {\usebeamercolor[fg]{subtitle}\large\insertsubtitle\par}
      {\color{wpgold}\rule{\linewidth}{1.5pt}\par}
      \vspace{0.6em}
      {\usebeamercolor[fg]{author}\insertauthor\par}
      {\usebeamercolor[fg]{institute}\small\insertinstitute\par}
      \vspace{0.3em}
      {\usebeamercolor[fg]{date}\small\insertdate\par}
    \end{column}
  \end{columns}}

\mode<all>
